CLAUDE.md

.obsidian/

# benchmark: what a snapshot can rebuild stays local; what defines and pins it is tracked
benchmark/record/snapshots/*/source/
# why: build-symbols rebuilds the symbol list from source/, while symbols.sha256 beside it stays
# tracked: it pins the universe the questions were sampled from, and the seal covers it
benchmark/record/snapshots/*/symbols.jsonl
benchmark/record/snapshots/*/indexes/*/*
!benchmark/record/snapshots/*/indexes/*/build.yaml
# why: the ignore file defines the corpus, not its contents, and build.yaml pins its sha256;
# without the bytes themselves no rebuild can ever match that hash
!benchmark/record/snapshots/*/indexes/*/*ignore*.used
# why: audit.check_attempts reads this file's revisions out of git history to hold the additive
# rule; untracked it has no history, so every transition reports as one the audit cannot find,
# and the rule the ledger's prepared_sha256 anchors is enforceable by nothing
!benchmark/record/snapshots/*/indexes/*/prepared_outputs.yaml
# why: a machine that still holds the old runs/ directory must not show it as dirt
benchmark/runs/
benchmark/record/runs/
# why: the summary verb derives both files from the ledger on demand; regenerating them is cheap
# and committing them would drift from the ledger the moment another attempt lands
benchmark/record/summary.json
benchmark/record/SUMMARY.md
# why: a vendor environment is rebuilt from the wheel, whose hash the ledger's environment_sha256 records
benchmark/envs/

# why: the lock's runtime facts are machine-local and root-owned, not repository content
benchmark/lock/machine.yaml
benchmark/lock/UNLOCKED

# raw outputs and examples hold target-project data
benchmark/systems/*/example/

# benchmark: models are frozen weights hashed in harness.yaml
benchmark/systems/*/models/

